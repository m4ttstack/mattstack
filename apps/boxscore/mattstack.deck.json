{
  "name": "boxscore",
  "displayName": "boxscore",
  "description": "Ranks a hand-picked set of GitLab users on a live leaderboard.",
  "icon": "./public/favicon.svg",
  "port": 11005,
  "includeInBundle": true,
  "requiresTeam": true,
  "bundle": {
    "build": "bun run build:bundle",
    "artifact": "dist-bin/app",
    "dotenv": false
  },
  "dev": {
    "start": "bun src/server/index.ts",
    "build": "bun run build",
    "deploy": "bun run build && deck restart boxscore"
  },
  "live": [
    { "kind": "server", "start": "bun --watch src/server/index.ts" },
    { "kind": "ui", "start": "bun x vite --port $PORT --strictPort" }
  ]
}
