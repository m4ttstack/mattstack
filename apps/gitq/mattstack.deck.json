{
  "name": "gitq",
  "displayName": "gitq",
  "description": "Stacked-branch management for git.",
  "icon": "./src/client/favicon.svg",
  "port": 11008,
  "includeInBundle": true,
  "dev": {
    "start": "bun src/server/server.ts",
    "build": "bun run build:client",
    "deploy": "bun run build:client && deck restart gitq"
  },
  "bundle": {
    "build": "bun install --frozen-lockfile && bun run build:binary",
    "artifact": "dist/gitq"
  }
}
