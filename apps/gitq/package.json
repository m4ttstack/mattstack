    "serve": "bun run src/server/server.ts"
  },
  "dependencies": {
    "@mattstack/rt-client": "file:../repo-tools/packages/rt-client",
    "@workforge/glance-sdk": "^0.11.0",
    "picomatch": "^4.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/picomatch": "^3.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.11",
    "typescript": "^5.9.3"
  }
}
