{
  "name": "gitq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "gitq": "bin/gitq"
  },
  "scripts": {
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun test tests/*.test.ts",
    "test:integration": "bun test --timeout 30000 tests/integration/",
