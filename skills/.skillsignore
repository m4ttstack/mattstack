# Skills in this directory that are NOT distributed to mattstack users.
#
# Read by `rt skills link --from <dir>`, the path the installer uses to link
# an app's bundled skills. A plain `rt skills link` in this checkout ignores
# this file and links everything, because that is the author linking their
# own work.
#
# Entries are directory names, one per line.

# Cutting and tagging an rt release. Maintainer action.
rt-release

# Regenerating the mattstack docs site after command changes. Maintainer action.
rt-docs

# The internal codec contract for state.db keys and daemon payloads. Applies
# to writing rt-estate code, not to using rt.
rt-repo-identity

# Rebuilding and reinstalling the dev app. Maintainer action.
rt-build-dev-app

# Running or debugging the mattstack.app build and publish pipeline by hand.
# Maintainer action.
mattstack-release

# Vendored docs-writing skills (doc-standards, Docusaurus). Read by path from
# website/AGENTS.md and the rt-docs skill.
doc-standards
docusaurus-config
docusaurus-documentation

# Writing short UI copy for mattstack apps. Maintainer action.
rt-ui-copy
