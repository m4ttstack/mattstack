// surface.jsonc -- names this pack's public skills. Everything else is
// internal and lives under attachments/, unregistered (compiler and
// runtime resolvers reach it by name, never the slash menu). Every dir
// under a plugin.json skills root (skills/, skills/review/, plugin/skills/)
// is a public door and must be named here, or compile fails it as misplaced;
// engines live under attachments/<group>/.
// Ratified 2026-08-21 (surface-ratchet amendment; engines-to-attachments
// follow-up same day). shepherdr here is the pack's own compiled verb
// (pack/stubs.jsonc), emitted to skills/shepherdr/; the engine stays under
// attachments/orchestration/.
{
  "public": [
    "subagent-review-loop",
    "editing-skills",
    "creating-a-pack",
    "extending-a-pack",
    "process-digraphs",
    "getting-current-time",
    "herd-progress",
    "shepherdr",
    "wrap-up",
    "writing-style-sparse",
    "writing-style-conversational",
    "writing-style-structured"
  ]
}
