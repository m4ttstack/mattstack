// Example bindings manifest. Copy to <repo>/.mattstack/skills.jsonc or
// ~/.mattstack/skills.jsonc and edit. Schema: ../schemas/skills-manifest.schema.json
// A binding key is an engine ref, plus /<block path> for a prop that lives on
// one of its blocks; each value binds one prop that block declares.
{
  "version": 2,
  "skills": {
    // Declarative record of the stack skills this repo uses (phase 1: docs only).
    "enabled": ["mattstack:shepherdr", "mattstack:model-tiering", "mattstack:execution-strategy", "mattstack:cswap-accounts"]
  },
  "pipelines": {
    // The stage roster. Plain /<pack>:work runs feature. A pipeline a work
    // verb runs starts with stage-provision, ends with stage-watch-ci, and
    // includes stage-implement and stage-ship.
    "feature": [
      "mattstack:stage-provision",
      "mattstack:stage-plan",
      "mattstack:stage-gates",
      "mattstack:stage-evidence",
      "mattstack:stage-implement",
      "mattstack:stage-self-review",
      "mattstack:stage-ship",
      "mattstack:stage-watch-ci"
    ],
    // A specialized pipeline, run by a work-a11y verb in pack/stubs.jsonc
    // ("pipeline": "accessibility"). For each prop its bindings name, the
    // pipeline's values replace every layer's top-level value, the org
    // base's included, in this pipeline only; compile writes the stage copy
    // stage-evidence--accessibility for it.
    "accessibility": {
      "stages": [
        "mattstack:stage-provision",
        "mattstack:stage-plan",
        "mattstack:stage-evidence",
        "mattstack:stage-implement",
        "mattstack:stage-ship",
        "mattstack:stage-watch-ci"
      ],
      "bindings": {
        // "" leaves no value for the prop in this pipeline, so it falls
        // back to its default: nothing inlined.
        "mattstack:stage-evidence/domain-rules": { "rules": "" }
      }
    }
  },
  "bindings": {
    // Prop "rules" (merge: add) on stage-evidence's Domain rules block:
    // every layer's value is inlined there, in layer order.
    "mattstack:stage-evidence/domain-rules": { "rules": "widgets:capture-evidence" },
    // Prop "tiering" (merge: replace, contract model-tiering@1) on
    // shepherdr's root block: this value replaces its default,
    // mattstack:model-tiering.
    "mattstack:shepherdr": { "tiering": "widgets:model-tiering" }
  }
}
