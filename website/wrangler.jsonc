{
  "name": "mattstack-docs",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "docs.mattstack.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "build",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
