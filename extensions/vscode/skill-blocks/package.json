{
  "name": "skill-blocks",
  "displayName": "Skill Blocks",
  "description": "Diagnostics, hover, navigation and rename for skill block files, served by rt skills lsp",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/m4ttstack/mattstack"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "workspaceContains:**/*.block.md",
    "workspaceContains:**/skills.jsonc"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "skill-blocks-markdown",
        "aliases": [
          "Skill Blocks Markdown"
        ],
        "extensions": [
          ".block.md"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "skill-blocks-markdown",
        "scopeName": "text.html.markdown.skill-blocks",
        "path": "./syntaxes/skill-blocks-markdown.tmLanguage.json",
        "embeddedLanguages": {
          "text.html.markdown": "markdown"
        }
      }
    ],
    "commands": [
      {
        "command": "skillBlocks.restartServer",
        "title": "Skill Blocks: Restart Server"
      }
    ],
    "configuration": {
      "title": "Skill Blocks",
      "properties": {
        "skillBlocks.rtPath": {
          "type": "string",
          "default": "rt",
          "description": "The rt executable that runs the language server (rt skills lsp). At the default, rt is looked up on the editor's PATH, then at ~/.local/bin/rt."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --main-fields=module,main --minify",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --main-fields=module,main --watch",
    "package": "bun run build && bunx vsce package --no-dependencies",
    "test": "bun test src/__tests__"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/vscode": "^1.91.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  }
}
