      "fill": "#f0f0f3",
      "gap": 48,
      "padding": 40,
      "children": [
        {
          "type": "frame",
          "id": "h1DePe",
          "name": "Principles",
          "width": 300,
          "layout": "vertical",
          "gap": 14,
          "children": [
            {
              "type": "text",
              "id": "rmMgA",
              "name": "Title",
              "fill": "#1c2024",
              "content": "A row note, from first principles",
              "fontFamily": "Roboto",
              "fontSize": 15,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "RsW5I",
              "name": "Lede",
              "fill": "#60646c",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "It is a line you write to your future self about one MR: where it is, what you're waiting on, a link you'll need. You read it while scanning the board far more often than you write it.",
              "lineHeight": 1.5,
              "fontFamily": "Roboto",
              "fontSize": 12.5,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "Z919Tj",
              "name": "Principle 1",
              "width": "fill_container",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "S2t6ME",
                  "name": "N",
                  "fill": "#0797b9",
                  "content": "1",
                  "fontFamily": "JetBrains Mono",
                  "fontSize": 11,
                  "fontWeight": "700"
                },
                {
                  "type": "frame",
                  "id": "x5YkA",
                  "name": "Copy",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 2,
                  "children": [
                    {
                      "type": "text",
                      "id": "quEE8",
                      "name": "H",
                      "fill": "#1c2024",
                      "content": "Yours, not the MR's",
                      "fontFamily": "Roboto",
                      "fontSize": 12.24,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "WEbSA",
                      "name": "B",
                      "fill": "#60646c",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The board's own state speaks in tones (needs a rebase, call doctor). Your note speaks in plain ink, marked by a cyan rule rather than a filled block.",
                      "lineHeight": 1.45,
                      "fontFamily": "Roboto",
                      "fontSize": 11.9,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "jnqq6",
              "name": "Principle 2",
              "width": "fill_container",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "dmBMA",
                  "name": "N",
                  "fill": "#0797b9",
                  "content": "2",
                  "fontFamily": "JetBrains Mono",
                  "fontSize": 11,
                  "fontWeight": "700"
                },
                {
                  "type": "frame",
                  "id": "xOrJk",
                  "name": "Copy",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 2,
                  "children": [
                    {
                      "type": "text",
                      "id": "ek6Yn",
                      "name": "H",
                      "fill": "#1c2024",
                      "content": "Glance first",
                      "fontFamily": "Roboto",
                      "fontSize": 12.24,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "A37Ack",
                      "name": "B",
                      "fill": "#60646c",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "One line at rest. The full text when you hover the row.",
                      "lineHeight": 1.45,
                      "fontFamily": "Roboto",
                      "fontSize": 11.9,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "c4ae4",
              "name": "Principle 3",
              "width": "fill_container",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "k3XxIX",
                  "name": "N",
                  "fill": "#0797b9",
                  "content": "3",
                  "fontFamily": "JetBrains Mono",
                  "fontSize": 11,
                  "fontWeight": "700"
                },
                {
                  "type": "frame",
                  "id": "vhQNb",
                  "name": "Copy",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 2,
                  "children": [
                    {
                      "type": "text",
                      "id": "zLBbW",
                      "name": "H",
                      "fill": "#1c2024",
                      "content": "Links are attachments",
                      "fontFamily": "Roboto",
                      "fontSize": 12.24,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "hHwUe",
                      "name": "B",
                      "fill": "#60646c",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A pasted URL becomes a chip that names its host, so the sentence stays a sentence.",
                      "lineHeight": 1.45,
                      "fontFamily": "Roboto",
                      "fontSize": 11.9,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "XaP6Q",
              "name": "Principle 4",
              "width": "fill_container",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "fUjzQ",
                  "name": "N",
                  "fill": "#0797b9",
                  "content": "4",
                  "fontFamily": "JetBrains Mono",
                  "fontSize": 11,
                  "fontWeight": "700"
                },
                {
                  "type": "frame",
                  "id": "lOnU5",
                  "name": "Copy",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 2,
                  "children": [
                    {
                      "type": "text",
                      "id": "ayi0u",
                      "name": "H",
                      "fill": "#1c2024",
                      "content": "Edit where it sits",
                      "fontFamily": "Roboto",
                      "fontSize": 12.24,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "W2C8A",
                      "name": "B",
                      "fill": "#60646c",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The line turns into a field in place. ↵ saves and esc cancels; one key cap shows, no hint row.",
                      "lineHeight": 1.45,
                      "fontFamily": "Roboto",
                      "fontSize": 11.9,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "M0j67",
              "name": "Principle 5",
              "width": "fill_container",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "FfLL8",
                  "name": "N",
                  "fill": "#0797b9",
                  "content": "5",
                  "fontFamily": "JetBrains Mono",
                  "fontSize": 11,
                  "fontWeight": "700"
                },
                {
                  "type": "frame",
                  "id": "iqA1R",
                  "name": "Copy",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 2,
                  "children": [
                    {
                      "type": "text",
                      "id": "zgQvf",
                      "name": "H",
                      "fill": "#1c2024",
                      "content": "Clearing is a verb",
                      "fontFamily": "Roboto",
                      "fontSize": 12.24,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "L3tas7",
                      "name": "B",
                      "fill": "#60646c",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "clear sits next to edit on hover. No rule about empty saves to learn.",
                      "lineHeight": 1.45,
                      "fontFamily": "Roboto",
                      "fontSize": 11.9,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "o1zTqw",
              "name": "Principle 6",
              "width": "fill_container",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "KqNGb",
                  "name": "N",
                  "fill": "#0797b9",
                  "content": "6",
                  "fontFamily": "JetBrains Mono",
                  "fontSize": 11,
                  "fontWeight": "700"
                },
                {
                  "type": "frame",
                  "id": "Bweg1",
                  "name": "Copy",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 2,
                  "children": [
                    {
                      "type": "text",
                      "id": "jGOGC",
                      "name": "H",
                      "fill": "#1c2024",
                      "content": "Notes go stale",
                      "fontFamily": "Roboto",
                      "fontSize": 12.24,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "Puz4w",
                      "name": "B",
                      "fill": "#60646c",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Each note says when you wrote it. Past a week the age turns amber. Needs a saved timestamp; notes are a bare string today.",
                      "lineHeight": 1.45,
                      "fontFamily": "Roboto",
                      "fontSize": 11.9,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
          ]
        },
