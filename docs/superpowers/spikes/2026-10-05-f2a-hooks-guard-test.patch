+/** Bookkeeping fixtures: deliberately do not register native filesystem watches. */
+function makeControlledWatch() {
+  class ControlledWatcher extends EventEmitter {
+    closeCalls = 0;
+    close(): void { this.closeCalls++; this.emit("close"); }
+    ref(): this { return this; }
+    unref(): this { return this; }
+  }
+  const watchers = new Map<string, ControlledWatcher>();
+  let watchCalls = 0;
+  const watchFn = (path: string) => {
+    watchCalls++;
+    const watcher = new ControlledWatcher();
+    watchers.set(path, watcher);
+    return watcher;
+  };
+  return {
+    watchers,
+    watchFn: watchFn as unknown as typeof import("fs").watch,
+    get watchCalls() { return watchCalls; },
+  };
+}
